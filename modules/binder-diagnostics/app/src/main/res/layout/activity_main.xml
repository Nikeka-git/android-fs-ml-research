<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- App Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <!-- Model description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/simulation_badge"
                android:textSize="14sp"
                android:textColor="@android:color/holo_blue_dark"
                android:textStyle="bold" />

            <!-- JNI Status -->
            <TextView
                android:id="@+id/native_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/loading"
                android:textSize="14sp"
                android:textColor="@android:color/holo_green_dark" />

            <!-- Control Buttons Section -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/darker_gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/control_section"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Discovery Button -->
            <Button
                android:id="@+id/btn_discovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_discovery"
                android:textSize="14sp" />

            <!-- Full Exploit Button -->
            <Button
                android:id="@+id/btn_full_exploit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_full_exploit"
                android:textSize="14sp" />

            <!-- Reset Button -->
            <Button
                android:id="@+id/btn_reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_reset"
                android:textSize="14sp"
                android:backgroundTint="@android:color/holo_orange_light" />

            <!-- Progress Bar -->
            <Button
                android:id="@+id/btn_device_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_device_mode"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_simulation_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_simulation_mode"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:indeterminate="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                style="?android:attr/progressBarStyleHorizontal" />

            <!-- Results Section -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/darker_gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/results_section"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- One outer scroll view keeps long reports readable on small screens. -->
            <TextView
                android:id="@+id/results_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/results_background"
                android:padding="8dp"
                android:minHeight="160dp"
                android:text="@string/results_placeholder"
                android:textSize="12sp"
                android:textIsSelectable="true"
                android:saveEnabled="false"
                android:fontFamily="monospace"
                android:textColor="@android:color/black" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
